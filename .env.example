# Reframe Configuration
# Copy this to .env and edit values

# === Required ===
JWT_SECRET=change-me-to-a-random-string
ADMIN_PASSWORD=change-me

# === Server ===
REFRAME_HOST=0.0.0.0
REFRAME_PORT=2283
REFRAME_LOG_LEVEL=info

# === Database ===
REFRAME_DB_PATH=/data/database/reframe.db

# === Storage ===
REFRAME_STORAGE_PATH=/data
REFRAME_STORAGE_BACKEND=filesystem
# S3-compatible storage (uncomment to use)
# REFRAME_S3_ENDPOINT=http://minio:9000
# REFRAME_S3_BUCKET=reframe
# REFRAME_S3_ACCESS_KEY=
# REFRAME_S3_SECRET_KEY=
# REFRAME_S3_REGION=us-east-1

# === ML Sidecar ===
REFRAME_ML_URL=http://reframe-ml:8100
REFRAME_ML_ENABLED=true
REFRAME_ML_FACE_RECOGNITION=true
REFRAME_ML_CLIP_SEARCH=true
REFRAME_ML_OCR=true

# === Redis ===
REFRAME_REDIS_URL=redis://reframe-redis:6379

# === Media Processing ===
REFRAME_THUMBNAIL_QUALITY=80
REFRAME_VIDEO_TRANSCODE_ENABLED=true
REFRAME_VIDEO_HW_ACCEL=auto
REFRAME_MAX_UPLOAD_SIZE_MB=500
REFRAME_FFMPEG_THREADS=0

# === Features ===
REFRAME_TRASH_AUTO_DELETE_DAYS=30
REFRAME_DEFAULT_STORAGE_QUOTA_GB=0
REFRAME_REGISTRATION_ENABLED=false
REFRAME_MAP_TILE_PROVIDER=osm
# REFRAME_MAPBOX_TOKEN=
REFRAME_GEOCODING_PROVIDER=nominatim

# === Timezone ===
TZ=America/Detroit
